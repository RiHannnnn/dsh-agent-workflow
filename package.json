{
  "name": "dsh-node-flow",
  "version": "0.1.0-codex.3",
  "private": true,
  "description": "DSH native Agent workflow canvas with a local Codex role library, live output and bounded paragraph handoff.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./ui": {
      "types": "./lib/ui.d.ts",
      "import": "./lib/ui.js"
    },
    "./client": {
      "types": "./lib/ui.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "examples/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.local.md",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:demo": "vite build",
    "build:client": "node scripts/build-client.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/build-client.mjs && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workflow",
    "canvas",
    "react-flow",
    "xyflow",
    "agent",
    "visual",
    "orchestration"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "smol-toml": "^1.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "license": "MIT"
}
